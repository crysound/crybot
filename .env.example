# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=crybot
CRYBOT_BIND_ADDRESS=127.0.0.1
CRYBOT_HTTP_PORT=8080
# Leave empty to use http://localhost:${CRYBOT_HTTP_PORT:-8080}.
CRYBOT_PUBLIC_URL=
# Leave empty to inherit CRYBOT_PUBLIC_URL.
CRYBOT_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set CRYBOT_PUBLIC_URL to https:// followed by the same hostname.
# Requires CRYBOT_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy.
CRYBOT_HTTPS_HOST=
CRYBOT_BASE_IMAGE=crybot:local
CRYBOT_LOCAL_IMAGE=crybot-local:latest
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
ENGINES="@anthropic-ai/claude-code @openai/codex"
# Leave empty for <COMPOSE_PROJECT_NAME>_data.
CRYBOT_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
CRYBOT_DATA_EXTERNAL=false
