{
  "sourceLanguage": "en",
  "strings": {
    "approval.held.native": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider requires your approval for this action."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提供方要求你批准这个操作。"
          }
        }
      }
    },
    "approval.held.outbound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This sends something on your behalf, so it asks you first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会以你的名义发送内容，因此会先询问你。"
          }
        }
      }
    },
    "approval.held.sandbox": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This loosens the AI's own safety limits, so only Full access can approve it automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会放宽 AI 自身的安全限制，因此只有完全访问才能自动批准。"
          }
        }
      }
    },
    "approval.held.undelivered": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve for me couldn't answer this one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代我批准无法回应这一条。"
          }
        }
      }
    },
    "approval.held.undeliveredFull": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full access couldn't deliver this approval."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完全访问未能送达这次批准。"
          }
        }
      }
    },
    "chat.notice.acpEmpty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{provider} finished without replying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{provider} 已结束，但没有回复。"
          }
        }
      }
    },
    "chat.notice.acpMcpAppsFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected apps couldn't be set up, so {provider} couldn't start this reply. Try again, or switch this bot to another AI."
          }
        }
      }
    },
    "chat.notice.acpMcpServerFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The \"{server}\" MCP server couldn't be set up, so {provider} couldn't start this reply. Try again, or switch this bot to another AI."
          }
        }
      }
    },
    "chat.notice.acpModelFallback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{displayName} no longer offers {wanted}, so this conversation uses {fallback}. Choose another model for this bot to stop seeing this."
          }
        }
      }
    },
    "chat.notice.acpModelRequestFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{name}'s model request failed: \"{message}\" {name} may retry or stop; no reply for {quiet} so far."
          }
        }
      }
    },
    "chat.notice.acpNoReason": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{provider} stopped without saying why."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{provider} 停止了，但没有说明原因。"
          }
        }
      }
    },
    "chat.notice.acpQuietStuck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} sent nothing for {quiet} with no tool running, no open request to its model and no CPU use, so the turn was stopped as stuck. Send the message again to retry."
          }
        }
      }
    },
    "chat.notice.acpQuietUsageLimit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} reached a usage limit{said} and is waiting it out without replying, so this turn was stopped."
          }
        }
      }
    },
    "chat.notice.acpRestarted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{provider} was restarted because a session sharing its process ignored Stop"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共用进程的会话忽略了「停止」，因此已重启 {provider}"
          }
        }
      }
    },
    "chat.notice.acpStopFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{provider} ignored Stop and its process could not be ended"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{provider} 忽略了「停止」，也无法结束它的进程"
          }
        }
      }
    },
    "chat.notice.appAccessRequested": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App access requested"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已请求应用访问权限"
          }
        }
      }
    },
    "chat.notice.approve": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve: {what}"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准：{what}"
          }
        }
      }
    },
    "chat.notice.backupCardWaiting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "switched to {name}. Your request waits on a card above and continues on {name} once you act on it."
          }
        }
      }
    },
    "chat.notice.backupContinuingLimit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "continuing on {name} after hitting the usage limit"
          }
        }
      }
    },
    "chat.notice.backupContinuingSignedOut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "continuing on {name} while {engine} is signed out"
          }
        }
      }
    },
    "chat.notice.backupConversationBusy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "switched to {name}. This conversation is working, so your message was not sent again."
          }
        }
      }
    },
    "chat.notice.backupCouldNotContinue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "could not continue on {name}: {error}"
          }
        }
      }
    },
    "chat.notice.backupMessageMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "switched to {name}, but your message could not be found to send again. Send it again."
          }
        }
      }
    },
    "chat.notice.backupQuestionWaiting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "switched to {name}. A teammate's question is waiting for your answer in this conversation, so your message was not sent again. Answer it, then send your message again."
          }
        }
      }
    },
    "chat.notice.backupRequestUnderWay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "switched to {name}. Your request is still under way here and continues on {name}."
          }
        }
      }
    },
    "chat.notice.claudeExtraUsage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude refused this turn because this model runs on extra usage for your account, and those credits are used up. Your plan's own usage is not affected: switch this bot to a model your plan includes, or add extra usage in your Claude account."
          }
        }
      }
    },
    "chat.notice.claudeLimit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Claude account has reached its {limit}. For now, {meanwhile}."
          }
        }
      }
    },
    "chat.notice.claudeLimitResets": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Claude account has reached its {limit}, which resets {resets}. Until then, {meanwhile}."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个 Claude 账户已达到{limit}，将于 {resets} 重置。在此之前，{meanwhile}。"
          }
        }
      }
    },
    "chat.notice.claudeLimitSaid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Claude account has reached its {limit} (Claude says: \"{said}\"). For now, {meanwhile}."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个 Claude 账户已达到{limit}（Claude 提示：「{said}」）。目前可以{meanwhile}。"
          }
        }
      }
    },
    "chat.notice.codexActionMayHaveRun": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{message} A tool action may have run. Check its effects before trying again."
          }
        }
      }
    },
    "chat.notice.codexElicitationDeclined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{server} asked for input Cry Bot can't show yet, so the request was declined."
          }
        }
      }
    },
    "chat.notice.codexElicitationDeclinedGeneric": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An MCP server asked for input Cry Bot can't show yet, so the request was declined."
          }
        }
      }
    },
    "chat.notice.codexModelUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This model isn't available on your ChatGPT plan, so it's now hidden from this account's model list. Pick another model."
          }
        }
      }
    },
    "chat.notice.codexUnsupportedMany": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex could not run the tools {tools} (\"unsupported call\"): the AI provider sent the call back without the tool's app name, so it never reached the tool. Pick a model for this bot whose provider handles tool calls fully."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 无法运行工具 {tools}（「unsupported call」）：AI 服务商返回的调用缺少工具的应用名，因此未能送达工具。请为这个智能体选择能完整处理工具调用的模型。"
          }
        }
      }
    },
    "chat.notice.codexUnsupportedMore": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex could not run the tools {tools} and {count} more (\"unsupported call\"): the AI provider sent the call back without the tool's app name, so it never reached the tool. Pick a model for this bot whose provider handles tool calls fully."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 无法运行工具 {tools} 及另外 {count} 个工具（「unsupported call」）：AI 服务商返回的调用缺少工具的应用名，因此未能送达工具。请为这个智能体选择能完整处理工具调用的模型。"
          }
        }
      }
    },
    "chat.notice.codexUnsupportedOne": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex could not run the tool {tools} (\"unsupported call\"): the AI provider sent the call back without the tool's app name, so it never reached the tool. Pick a model for this bot whose provider handles tool calls fully."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 无法运行工具 {tools}（「unsupported call」）：AI 服务商返回的调用缺少工具的应用名，因此未能送达工具。请为这个智能体选择能完整处理工具调用的模型。"
          }
        }
      }
    },
