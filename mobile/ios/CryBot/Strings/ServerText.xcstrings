          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse é um código de login de um e-mail. O pareamento precisa de um código de 12 caracteres como 7KQ2-M9XD-H4TP."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это код входа из письма. Для связки нужен 12-символьный код вроде 7KQ2-M9XD-H4TP."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir e-postadan gelen giriş kodu. Eşleştirme için 7KQ2-M9XD-H4TP gibi 12 karakterli bir kod gerekir."
          }
        },
        "uk": {
          "stringUnit": {
