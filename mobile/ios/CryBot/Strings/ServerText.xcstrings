        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "{provider} 拒絕繼續處理這個請求（停止原因：{reason}）。請再試一次、換個說法，或把這個智能體切換到另一個 AI。"
          }
        }
      }
    },
