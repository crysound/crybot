    "chat.notice.stop.refusal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{provider} refused to go on with this request (stop reason: {reason}). Try again, reword the request, or switch this bot to another AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
