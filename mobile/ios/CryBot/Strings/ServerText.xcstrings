      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI's request was cut off before it finished, and nobody stopped it (it said only \"{said}\"). Send the message again to try once more."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pedido da IA foi interrompido antes de terminar, sem que ninguém o parasse (ela disse apenas “{said}”). Envie a mensagem novamente para tentar mais uma vez."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 的請求在完成前被中斷，而且沒有人停止它（它只說了「{said}」）。請再傳送一次訊息重試。"
          }
        }
      }
    },
    "chat.notice.unknownTeammateWorking": {
      "extractionState": "manual",
      "localizations": {
        "en": {
