    "serverError.page.downloadHasFiles": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neben dieser Seite liegen weitere Dateien, daher kann sie nicht als eine Datei gespeichert werden. Teile sie stattdessen als Link."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This page has files beside it, so it can't be saved as one file. Share it for a link instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página tiene archivos junto a ella, así que no se puede guardar como un solo archivo. Compártela para obtener un enlace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette page a des fichiers à côté d'elle, elle ne peut donc pas être enregistrée en un seul fichier. Partagez-la pour obtenir un lien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस पेज के साथ और फ़ाइलें हैं, इसलिए इसे एक फ़ाइल के रूप में सहेजा नहीं जा सकता। इसके बजाय लिंक के लिए इसे शेयर करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa pagina ha dei file accanto, quindi non può essere salvata come un unico file. Condividila per ottenere un link."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページには横にファイルがあるため、1つのファイルとして保存できません。代わりに共有してリンクを取得してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 페이지에는 함께 있는 파일이 있어 하나의 파일로 저장할 수 없습니다. 대신 공유해서 링크를 받으세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta strona ma obok siebie pliki, więc nie można jej zapisać jako jednego pliku. Udostępnij ją, aby otrzymać link."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página tem arquivos ao lado, então não pode ser salva como um único arquivo. Compartilhe-a para obter um link."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рядом с этой страницей есть файлы, поэтому её нельзя сохранить одним файлом. Поделитесь ею, чтобы получить ссылку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sayfanın yanında dosyalar var, bu yüzden tek bir dosya olarak kaydedilemez. Bunun yerine bağlantı almak için paylaşın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поруч із цією сторінкою є файли, тому її не можна зберегти одним файлом. Поділіться нею, щоб отримати посилання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trang này có tệp đi kèm nên không thể lưu thành một tệp. Hãy chia sẻ để lấy liên kết."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此頁面旁邊還有其他檔案，無法儲存為單一檔案。請改為分享以取得連結。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此页面旁边还有其他文件，无法保存为单个文件。请改为分享以获取链接。"
          }
        }
      }
    },
