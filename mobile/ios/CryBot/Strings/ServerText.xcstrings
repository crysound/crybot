    "serverError.pair.emailCode": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist ein Anmeldecode aus einer E-Mail. Zum Koppeln brauchst du einen 12-stelligen Code wie 7KQ2-M9XD-H4TP."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's a sign-in code from an email. Pairing needs a 12-character code like 7KQ2-M9XD-H4TP."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese es un código de inicio de sesión de un correo. Para vincular necesitas un código de 12 caracteres como 7KQ2-M9XD-H4TP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
