    "chat.notice.stop.maxRequests": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The turn made as many model requests as one turn may before it finished (stop reason: %@). Ask it to carry on from where it stopped, or split the task."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão atingiu o limite de pedidos ao modelo antes de terminar (motivo da parada: %@). Peça para continuar de onde parou ou divida a tarefa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個回合在完成前已用完單一回合允許的模型請求次數（停止原因：%@）。請要求它從停下的地方繼續，或把工作拆開。"
          }
        }
      }
    },
    "chat.notice.stop.maxTokens": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@'s reply reached its maximum length before it finished (stop reason: %2$@). Ask it to continue, or ask for a shorter answer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta de %1$@ atingiu o tamanho máximo antes de terminar (motivo da parada: %2$@). Peça para continuar ou dar uma resposta mais curta."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的回覆在完成前就達到了長度上限（停止原因：%2$@）。請要求它繼續，或要求較短的回答。"
          }
        }
      }
    },
