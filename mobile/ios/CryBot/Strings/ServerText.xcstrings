    },
    "chat.notice.computerAiUnsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "this bot's AI can't use this computer — pick another AI for this bot, or choose another place for it to work"
          }
        },
        "pt-BR": {
