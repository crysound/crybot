    "chat.notice.codexUnsupportedMany": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex could not run the tools {tools} (\"unsupported call\"): the AI provider sent the call back without the tool's app name, so it never reached the tool. Pick a model for this bot whose provider handles tool calls fully."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Codex não conseguiu executar as ferramentas {tools} (“unsupported call”). O provedor de IA devolveu a chamada sem o nome do app da ferramenta, e ela nunca chegou à ferramenta. Para este bot, escolha um modelo de um provedor com suporte completo a chamadas de ferramentas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 無法執行工具 {tools}（「unsupported call」）：AI 供應商送回的呼叫缺少工具的應用程式名稱，所以它們沒有送達工具。請為這個智能體選擇一個能完整處理工具呼叫的供應商模型。"
          }
        }
      }
    },
