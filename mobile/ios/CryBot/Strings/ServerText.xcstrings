      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reply wait is available for OpenAI-compatible servers only."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo de espera pela resposta só está disponível para servidores compatíveis com OpenAI."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回覆等待時間只適用於與 OpenAI 相容的伺服器。"
          }
        }
      }
    },
    "serverError.instance.settingsInvalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supply a valid CLI path, account name, configuration directory, boolean tools setting or a reply wait of 1 to 60 minutes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe um caminho válido para a CLI, um nome de conta, uma pasta de configuração, uma opção booleana de ferramentas ou um tempo de espera pela resposta de 1 a 60 minutos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請提供有效的 CLI 路徑、帳號名稱、設定目錄、布林值工具設定，或 1 到 60 分鐘的回覆等待時間。"
          }
        }
      }
    },
    "serverError.mailbox.addressAndPassword": {
