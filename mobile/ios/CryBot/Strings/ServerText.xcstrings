    "chat.notice.toolCount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ refused this turn because this model takes at most %2$@ tools and this bot offers more, even with its tool lists trimmed, so nothing ran. Turn off some of this bot's apps or MCP servers, or switch the bot to another model."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ recusou esta sessão porque o limite de ferramentas deste modelo é %2$@ e este bot oferece mais, mesmo com as listas reduzidas. Nada foi executado. Desligue alguns apps ou servidores MCP deste bot, ou mude para outro modelo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 拒絕了這個回合，因為這個模型最多只能接受 %2$@ 個工具，而這個智能體即使精簡了工具清單仍提供更多，所以沒有執行任何動作。請關閉這個智能體的部分應用程式或 MCP 伺服器，或把智能體切換到另一個模型。"
          }
        }
      }
    },
