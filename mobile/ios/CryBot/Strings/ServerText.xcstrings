        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我回到這台電腦上了，所以我的 webhook「%1$@」在這裡又有位址了。請開啟「自動化」，在「%1$@」上選擇「拷貝位址」，然後貼到傳送給它的應用程式中。"
          }
        }
      }
