    "chat.notice.computerDesktopOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the Cry Bot app on this computer can let a bot use it. Open the app here, or let the bot work in its own browser or on a cloud desktop instead."
          }
