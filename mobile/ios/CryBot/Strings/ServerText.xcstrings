{
  "sourceLanguage": "en",
  "strings": {
    "chat.notice.acpEmpty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ finished without replying."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ terminou sem responder."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 結束了但沒有回覆。"
          }
        }
      }
    },
    "chat.notice.acpMcpAppsFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected apps couldn't be set up, so %@ couldn't start this reply. Try again, or switch this bot to another AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível configurar os apps conectados, então %@ não conseguiu começar esta resposta. Tente de novo ou troque a IA deste bot."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法設定已連線的應用程式，因此 %@ 無法開始這則回覆。請再試一次，或將這個智能體切換到其他 AI。"
          }
        }
      }
    },
    "chat.notice.acpMcpServerFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The \"%1$@\" MCP server couldn't be set up, so %2$@ couldn't start this reply. Try again, or switch this bot to another AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível configurar o servidor MCP \"%1$@\", então %2$@ não conseguiu começar esta resposta. Tente de novo ou troque a IA deste bot."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法設定「%1$@」MCP 伺服器，因此 %2$@ 無法開始這則回覆。請再試一次，或將這個智能體切換到其他 AI。"
          }
        }
      }
    },
    "chat.notice.acpModelFallback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no longer offers %2$@, so this conversation uses %3$@. Choose another model for this bot to stop seeing this."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ não oferece mais %2$@, então esta conversa está usando %3$@. Para não ver mais este aviso, escolha outro modelo para este bot."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已不再提供 %2$@，因此這段對話改用 %3$@。為這個智能體選擇其他模型即可不再看到這則訊息。"
          }
        }
      }
    },
    "chat.notice.acpModelRequestFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@'s model request failed: \"%2$@\" %1$@ may retry or stop; no reply for %3$@ so far."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pedido de %1$@ ao modelo falhou: “%2$@”. %1$@ pode tentar novamente ou parar. Sem resposta há %3$@."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的模型請求失敗：「%2$@」%1$@ 可能會重試或停止；目前已 %3$@ 沒有回覆。"
          }
        }
      }
    },
    "chat.notice.acpNoReason": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stopped without saying why."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ parou sem informar o motivo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 停止了但沒有說明原因。"
          }
        }
      }
    },
    "chat.notice.acpQuietStuck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sent nothing for %2$@ with no tool running, no open request to its model and no CPU use, so the turn was stopped as stuck. Send the message again to retry."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ficou %2$@ sem enviar nada. Não havia ferramenta em execução, pedido aberto ao modelo nem uso de CPU, então a sessão foi interrompida por estar travada. Envie a mensagem de novo para tentar novamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已經 %2$@ 沒有傳送任何內容，沒有工具在執行、沒有對模型的未完成請求，也沒有使用 CPU，因此這個回合被視為卡住而停止。請再傳送一次訊息重試。"
          }
        }
      }
    },
    "chat.notice.acpQuietUsageLimit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ reached a usage limit%2$@ and is waiting it out without replying, so this turn was stopped."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ atingiu um limite de uso%2$@ e está esperando a restrição acabar, sem responder. Por isso, esta sessão foi interrompida."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已達到使用上限%2$@，正在等待重設而沒有回覆，因此這個回合已停止。"
          }
        }
      }
    },
    "chat.notice.acpRestarted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was restarted because a session sharing its process ignored Stop"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ foi reiniciado porque uma sessão que compartilha seu processo ignorou “Parar”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已重新啟動，因為共用其程序的一個工作階段忽略了「停止」"
          }
        }
      }
    },
    "chat.notice.acpStopFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ignored Stop and its process could not be ended"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ignorou “Parar” e não foi possível encerrar seu processo"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 忽略了「停止」，且無法結束它的程序"
          }
        }
      }
    },
    "chat.notice.appAccessRequested": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App access requested"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedido de acesso ao app"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已要求應用程式存取權"
          }
        }
      }
    },
    "chat.notice.approve": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprovar: %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核准：%@"
          }
        }
      }
    },
    "chat.notice.backupCardWaiting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "switched to %1$@. Your request waits on a card above and continues on %1$@ once you act on it."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudou para %1$@. Seu pedido aguarda sua ação em um cartão acima. Depois disso, continua em %1$@."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已切換到 %1$@。你的請求正在等待上方的卡片，等你處理後會在 %1$@ 上繼續。"
          }
        }
      }
    },
    "chat.notice.backupContinuingLimit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "continuing on %@ after hitting the usage limit"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuando em %@ depois de atingir o limite de uso"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "達到使用上限後，改在 %@ 上繼續"
          }
        }
      }
    },
    "chat.notice.backupContinuingSignedOut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "continuing on %1$@ while %2$@ is signed out"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuando em %1$@ enquanto %2$@ está sem login"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已登出，改在 %2$@ 上繼續"
          }
        }
      }
    },
    "chat.notice.backupConversationBusy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "switched to %@. This conversation is working, so your message was not sent again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudou para %@. O bot está trabalhando nesta conversa, então sua mensagem não foi enviada novamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已切換到 %@。這段對話正在工作，因此你的訊息沒有重新傳送。"
          }
        }
      }
    },
    "chat.notice.backupCouldNotContinue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "could not continue on %1$@: %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível continuar em %1$@: %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法在 %1$@ 上繼續：%2$@"
          }
        }
      }
    },
    "chat.notice.backupMessageMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "switched to %@, but your message could not be found to send again. Send it again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudou para %@, mas não foi possível encontrar sua mensagem para reenviar. Envie novamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已切換到 %@，但找不到你的訊息來重新傳送。請再傳送一次。"
          }
        }
      }
    },
    "chat.notice.backupQuestionWaiting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "switched to %@. A teammate's question is waiting for your answer in this conversation, so your message was not sent again. Answer it, then send your message again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudou para %@. Um colega aguarda sua resposta a uma pergunta nesta conversa, por isso sua mensagem não foi reenviada. Responda à pergunta e depois envie sua mensagem novamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已切換到 %@。這段對話中有一位隊友的問題正在等你回答，因此你的訊息沒有重新傳送。請先回答，再重新傳送你的訊息。"
          }
        }
      }
    },
    "chat.notice.backupRequestUnderWay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "switched to %1$@. Your request is still under way here and continues on %1$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudou para %1$@. Seu pedido ainda está em andamento aqui e continua em %1$@."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已切換到 %1$@。你的請求仍在這裡進行中，並會在 %1$@ 上繼續。"
          }
        }
      }
    },
    "chat.notice.claudeExtraUsage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude refused this turn because this model runs on extra usage for your account, and those credits are used up. Your plan's own usage is not affected: switch this bot to a model your plan includes, or add extra usage in your Claude account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Claude recusou esta sessão porque este modelo consome os créditos de uso extra da sua conta, e esses créditos acabaram. O uso do seu plano não foi afetado: troque este bot para um modelo incluído no plano ou adicione uso extra na sua conta do Claude."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 拒絕了這個回合，因為這個模型會使用你帳號的額外用量，而這些額度已用完。你方案本身的用量不受影響：請把這個智能體切換到你方案包含的模型，或在你的 Claude 帳號中加購額外用量。"
          }
        }
      }
    },
    "chat.notice.claudeLimit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Claude account has reached its %1$@. For now, %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta do Claude atingiu o %1$@. Por enquanto, %2$@."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個 Claude 帳號已達到%1$@。目前請%2$@。"
          }
        }
      }
    },
    "chat.notice.claudeLimitResets": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Claude account has reached its %1$@, which resets %2$@. Until then, %3$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta do Claude atingiu o %1$@, que será renovado em %2$@. Até lá, %3$@."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個 Claude 帳號已達到%1$@，將於%2$@重設。在那之前，%3$@。"
          }
        }
      }
    },
    "chat.notice.claudeLimitSaid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Claude account has reached its %1$@ (Claude says: \"%2$@\"). For now, %3$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta do Claude atingiu o %1$@ (o Claude diz: “%2$@”). Por enquanto, %3$@."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個 Claude 帳號已達到%1$@（Claude 表示：「%2$@」）。目前請%3$@。"
          }
        }
      }
    },
    "chat.notice.codexActionMayHaveRun": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ A tool action may have run. Check its effects before trying again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Uma ferramenta pode ter executado uma ação. Confira os efeitos antes de tentar novamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 某個工具動作可能已經執行。重試前請先檢查它的影響。"
          }
        }
      }
    },
    "chat.notice.codexElicitationDeclined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ asked for input Cry Bot can't show yet, so the request was declined."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pediu informações que o Cry Bot ainda não pode mostrar, então o pedido foi recusado."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 要求了 Cry Bot 還無法顯示的輸入，因此已拒絕這個請求。"
          }
        }
      }
    },
    "chat.notice.codexElicitationDeclinedGeneric": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An MCP server asked for input Cry Bot can't show yet, so the request was declined."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um servidor MCP pediu informações que o Cry Bot ainda não pode mostrar, então o pedido foi recusado."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有一個 MCP 伺服器要求了 Cry Bot 還無法顯示的輸入，因此已拒絕這個請求。"
          }
        }
      }
    },
    "chat.notice.codexModelUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This model isn't available on your ChatGPT plan, so it's now hidden from this account's model list. Pick another model."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo não está disponível no seu plano do ChatGPT, por isso agora está oculto na lista de modelos desta conta. Escolha outro modelo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 ChatGPT 方案不提供這個模型，因此它已從這個帳號的模型清單中隱藏。請選擇其他模型。"
          }
        }
      }
    },
    "chat.notice.codexUnsupportedMany": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex could not run the tools %@ (\"unsupported call\"): the AI provider sent the call back without the tool's app name, so it never reached the tool. Pick a model for this bot whose provider handles tool calls fully."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Codex não conseguiu executar as ferramentas %@ (“unsupported call”). O provedor de IA devolveu a chamada sem o nome do app da ferramenta, e ela nunca chegou à ferramenta. Para este bot, escolha um modelo de um provedor com suporte completo a chamadas de ferramentas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 無法執行工具 %@（「unsupported call」）：AI 供應商送回的呼叫缺少工具的應用程式名稱，所以它們沒有送達工具。請為這個智能體選擇一個能完整處理工具呼叫的供應商模型。"
          }
        }
      }
    },
    "chat.notice.codexUnsupportedMore": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex could not run the tools %1$@ and %2$@ more (\"unsupported call\"): the AI provider sent the call back without the tool's app name, so it never reached the tool. Pick a model for this bot whose provider handles tool calls fully."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Codex não conseguiu executar as ferramentas %1$@ e mais %2$@ (“unsupported call”). O provedor de IA devolveu a chamada sem o nome do app da ferramenta, e ela nunca chegou à ferramenta. Para este bot, escolha um modelo de um provedor com suporte completo a chamadas de ferramentas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 無法執行工具 %1$@ 以及另外 %2$@ 個（「unsupported call」）：AI 供應商送回的呼叫缺少工具的應用程式名稱，所以它們沒有送達工具。請為這個智能體選擇一個能完整處理工具呼叫的供應商模型。"
          }
        }
      }
    },
    "chat.notice.codexUnsupportedOne": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex could not run the tool %@ (\"unsupported call\"): the AI provider sent the call back without the tool's app name, so it never reached the tool. Pick a model for this bot whose provider handles tool calls fully."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Codex não conseguiu executar a ferramenta %@ (“unsupported call”). O provedor de IA devolveu a chamada sem o nome do app da ferramenta, e ela nunca chegou à ferramenta. Para este bot, escolha um modelo de um provedor com suporte completo a chamadas de ferramentas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 無法執行工具 %@（「unsupported call」）：AI 供應商送回的呼叫缺少工具的應用程式名稱，所以它沒有送達工具。請為這個智能體選擇一個能完整處理工具呼叫的供應商模型。"
          }
        }
      }
    },
    "chat.notice.commandCodeAccountRefused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command Code refused this request for the signed-in account. Check its plan and credits on commandcode.ai, then try again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Command Code recusou este pedido para a conta conectada. Confira o plano e os créditos em commandcode.ai e tente novamente."
