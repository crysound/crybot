    "chat.notice.piSessionSlow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi is taking longer than usual to start this conversation's session. The turn goes on when Pi answers. Press Stop to cancel it."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pi está demorando mais que o normal para iniciar a sessão desta conversa. A sessão de trabalho continua quando o Pi responder. Clique em “Parar” para cancelar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi 啟動這段對話的工作階段比平常久。等 Pi 回應後，回合就會繼續。按「停止」可取消。"
          }
        }
      }
    },
    "chat.notice.previousComputerWakeFailed": {
