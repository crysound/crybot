    "serverError.mailbox.outgoingFields": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe den Postausgangsserver: ein Name wie mail.example.com, ein Port von 1 bis 65535 und SSL/TLS oder STARTTLS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the outgoing server: a name like mail.example.com, a port from 1 to 65535, and SSL/TLS or STARTTLS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa el servidor de salida: un nombre como mail.example.com, un puerto de 1 a 65535 y SSL/TLS o STARTTLS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le serveur sortant : un nom comme mail.example.com, un port de 1 à 65535, et SSL/TLS ou STARTTLS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आउटगोइंग सर्वर जाँचें: mail.example.com जैसा नाम, 1 से 65535 तक का पोर्ट, और SSL/TLS या STARTTLS।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla il server in uscita: un nome come mail.example.com, una porta da 1 a 65535 e SSL/TLS o STARTTLS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信サーバーを確認してください: mail.example.com のような名前、1〜65535 のポート、SSL/TLS または STARTTLS。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내는 서버를 확인하세요: mail.example.com 같은 이름, 1~65535 사이의 포트, SSL/TLS 또는 STARTTLS."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź serwer wychodzący: nazwa w rodzaju mail.example.com, port od 1 do 65535 oraz SSL/TLS lub STARTTLS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira o servidor de saída: um nome como mail.example.com, uma porta de 1 a 65535 e SSL/TLS ou STARTTLS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте сервер исходящей почты: имя вроде mail.example.com, порт от 1 до 65535 и SSL/TLS или STARTTLS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giden sunucuyu kontrol edin: mail.example.com gibi bir ad, 1 ile 65535 arasında bir bağlantı noktası ve SSL/TLS veya STARTTLS."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте сервер вихідної пошти: назва на кшталт mail.example.com, порт від 1 до 65535 і SSL/TLS або STARTTLS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy kiểm tra máy chủ thư đi: một tên như mail.example.com, cổng từ 1 đến 65535, và SSL/TLS hoặc STARTTLS."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查外寄伺服器：名稱如 mail.example.com、1 到 65535 之間的連接埠，以及 SSL/TLS 或 STARTTLS。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查发件服务器：名称如 mail.example.com，端口在 1 到 65535 之间，以及 SSL/TLS 或 STARTTLS。"
          }
        }
      }
    },
